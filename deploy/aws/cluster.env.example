# Copia este archivo a cluster.env y completa con las IP PRIVADAS de tus VM (columna "IPv4 privada" en EC2).
CONTROL_IPS="10.0.1.11 10.0.1.12 10.0.1.13"           # 3 VM de control (etcd + servicio de control)
DATA_IPS="10.0.1.21 10.0.1.22 10.0.1.23 10.0.1.24"     # 4 o más VM de datos (dn1, dn2, ...)
CLIENT_IPS="10.0.1.31"                                  # VM(s) cliente
SSH_KEY="$HOME/labsuser.pem"                            # llave .pem del Learner Lab
SSH_USER="ubuntu"
REPO_DIR="/home/ubuntu/dfsha"                           # dónde se copia el proyecto en cada VM
# IP/nombre por el que TÚ (máquina desde la que ejecutas distribute.sh) llegas a las VM por SSH.
# Si las IP privadas no son alcanzables desde tu PC, ejecuta distribute.sh desde la VM cliente (recomendado).
